{
  "name": "viperstrike",
  "productName": "Viperstrike",
  "version": "1.16.1",
  "description": "Personal daily-life hub: screen time, game launcher and music.",
  "author": "Viperstrike",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "icon": "node scripts/make-icon.js",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis --publish never",
    "release": "vite build && electron-builder --win nsis --publish never && node scripts/release.js"
  },
  "build": {
    "appId": "com.viperstrike.app",
    "productName": "Viperstrike",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bessonz",
        "repo": "Viperstrike",
        "releaseType": "release"
      }
    ],
    "files": [
      "electron/**",
      "assets/**",
      "dist/**",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Viperstrike",
      "artifactName": "Viperstrike-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.6"
  }
}
